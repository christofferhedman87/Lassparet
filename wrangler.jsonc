{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "larsparet-teknisk-poc",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "larsparet-poc",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
